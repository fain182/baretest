{
    "name": "fain182/baretest",
    "description": "A small test runner for PHP libraries. No dependencies, no extensions.",
    "type": "library",
    "license": "MIT",
    "keywords": ["test", "testing", "test-runner"],
    "require": {
        "php": ">=7.4"
    },
    "bin": ["bin/baretest"],
    "autoload": {
        "psr-4": {"Baretest\\": "src/"},
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {"Baretest\\Tests\\": "tests/"}
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7"
    }
}
